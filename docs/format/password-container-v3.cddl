; SPDX-License-Identifier: CC0-1.0
; SCPEFE unreleased v3 payload, following the 16-byte document ID.
; RFC 8949 core deterministic CBOR, definite lengths, shortest encodings,
; ascending numeric map keys, strict UTF-8, no unknown keys except extensions.
; Semantic and cross-field invariants are normative in password-container-v3.md.

container-v3 = {
  1: 1,                         ; schema version
  2: [1*9 slot-metadata],
  3: owner-identity,
  4: editing-lease,
  5: [1* revision-record],
  6: revision-id,               ; canonical head
  7: revision-id,               ; latest canonical content revision
  8: [* uint],                  ; sorted required feature IDs; initially []
  ? 9: { * extension-key => extension-value },
}

slot-metadata = {
  1: slot-id,
  2: 0..7,                     ; effective permission bits
  3: bool,                     ; effective must-be-changed
  4: 0..2,                     ; 0 owner, 1 ordinary, 2 recovery
  5: bstr .size 16,           ; opaque management ID
  6: tstr,                      ; name, empty only for recovery
  7: tstr,                      ; email, empty only for recovery
}

owner-identity = {
  1: slot-id,                  ; slot 0's immutable ID
  2: tstr,                     ; name
  3: tstr,                     ; email
}

editing-lease = {
  1: bool,                     ; active
  2: bstr .size 16,           ; session ID, zero when inactive
  3: uint,                     ; heartbeat counter
  4: timestamp,                ; holder time
  5: 1..9223372036854775807,  ; duration milliseconds
  6: tstr,                     ; holder name
  7: tstr,                     ; holder email
  8: tstr,                     ; holder device
}

revision-record = {
  1: revision-id,
  2: immutable-revision,
  3: 0..5,                     ; 0 event, 1 full, 2 delta,
                               ; 3 checkpoint, 4 pruned, 5 foreign
  ? 4: full-body / delta-body,
  ? 5: true,                   ; provisional, last canonical content only
  ? 6: revision-id,            ; resolved by merge; foreign only
  ? 7: true,                   ; foreign metadata-only marker
}

immutable-revision = {
  1: 0..2,                     ; original kind: baseline/delta/event
  ? 2: revision-id,            ; previous canonical head, or foreign head
  ? 3: revision-id,            ; content parent, content records only
  4: [* revision-id],          ; sorted distinct merge-source IDs
  5: timestamp,
  6: slot-id,                  ; actor slot
  7: tstr,                     ; actor name
  8: tstr,                     ; actor email
  9: tstr,                     ; client profile name
  10: tstr,                    ; client profile email
  11: tstr,                    ; device
  12: digest,                  ; resulting content hash
  ? 13: digest,                ; original body digest, content only
  ? 14: tstr,                  ; event type, event only
  ? 15: event-details,         ; event details, event only
}

event-details = {
  ? 1: slot-id,                ; affected slot
  ? 2: revision-id,            ; compaction cutoff
  ? 3: uint,                   ; retained content deltas
  ? 4: 0..2,                   ; attempted/succeeded/failed
  ? 5: tstr,                   ; redacted descriptive detail
}

full-body = [0, uint, bstr]     ; none codec, UTF-8 byte count, UTF-8 text
; A delta's declared length is the reconstructed UTF-8 byte count.
delta-body = [0, uint, [* delta-segment]]
delta-segment = copy-segment / insert-segment
copy-segment = [0, uint, 1..18446744073709551615] ; source byte start and nonzero count
insert-segment = [1, bstr]     ; nonempty UTF-8 byte string

extension-key = 1000..18446744073709551615
extension-value = null / bool / int / bstr / tstr /
                  [* extension-value] / { * uint => extension-value }
revision-id = bstr .size 32
slot-id = bstr .size 16
digest = bstr .size 32
timestamp = 0..9223372036854775807
