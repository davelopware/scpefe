; SPDX-License-Identifier: CC0-1.0
; SCPEFE deterministic-CBOR snapshot revision record, format version 1.
; Every map and array has a definite length. Map keys use the order shown.
; Integers and lengths use their shortest RFC 8949 encoding. Text is valid UTF-8.
; No tags, floats, simple values, duplicate keys, unknown keys, or trailing octets.

snapshot-revision-v1 = {
  1: 1,                         ; record format version
  2: [* revision-id],           ; parent revision IDs
  3: uint,                      ; Unix timestamp in milliseconds
  4: slot-id,                   ; authoring password slot
  5: tstr,                      ; registered slot identity name
  6: tstr,                      ; registered slot identity email
  7: tstr,                      ; current client profile name
  8: tstr,                      ; current client profile email
  9: tstr,                      ; device name
  10: content-hash,
  11: snapshot-v1,
}

snapshot-v1 = {
  1: 0,                         ; codec: none
  2: uint,                      ; UTF-8 octet length of field 3
  3: tstr,                      ; canonical document text
}

revision-id = bytes .size 32
slot-id = bytes .size 16
content-hash = bytes .size 32
